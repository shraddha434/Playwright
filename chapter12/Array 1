//negative index counts from the end: -1 is the last element, -2 the one before it. at() understands that, the square brackets do not:

let browsers = ['chrome', 'firefox', 'edge'];
console.log(browsers.at(0));    // chrome
console.log(browsers.at(-1));   // edge
console.log(browsers.at(-2));   // firefox
console.log(browsers[-1]);      // undefined

